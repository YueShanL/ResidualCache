  },
  "evaluation": {
    "top_n": 4,
    "device": "cuda"
  },
  "replay": {
    "enabled": true,
    "split": "test",
    "policy": "fixed",
    "top_n": 4,
    "score_threshold": 0.0,
    "maximum_samples": 64,
    "router_device": "cuda"
  },
  "stages": {
    "prepare": true,
    "collect": true,
    "train": true,
    "evaluate": true,
    "replay": true
  }
